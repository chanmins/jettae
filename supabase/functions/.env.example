# scripts/gen-vapid.mjs 로 만든 키를 넣는다.
# supabase secrets set --env-file supabase/functions/.env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# 배포된 앱 주소. 이메일 폴백 링크에 쓴다.
APP_URL=https://jettae.pages.dev

# 없으면 조용한 실패를 표시만 하고 메일은 보내지 않는다.
RESEND_API_KEY=
MAIL_FROM=제때 <hello@example.com>

# 크론 → 엣지 함수 호출 인증. Vault의 cron_secret과 같은 값이어야 한다.
# 아무 난수면 된다. 비우면 service_role 키로 대체하지만 권하지 않는다.
CRON_SECRET=
